    """登录接口完整 URL"""
    return f"{base_url}/admin/login"


def _do_login(base_url: str, username: str, password: str) -> str:
    """执行登录并获取 Token"""
    resp = requests.post(
        f"{base_url}/admin/login",
        json={"username": username, "password": password},
        timeout=30
    )
    assert resp.status_code == 200, f"登录失败 HTTP {resp.status_code}"
    body = resp.json()
    assert body.get("code") == 200, f"登录失败: {body.get('message')}"
    return body["data"]["token"]


@pytest.fixture(scope="session")
def admin_token(base_url, accounts):
    """管理员 Token（session 级别，整个测试会话复用）"""
    for acct in accounts:
        if acct.get("role") == "admin":
            return _do_login(base_url, acct["username"], acct["password"])
    pytest.fail("config.yaml 中未找到 admin 角色账号")


@pytest.fixture(scope="session")
def visitor_token(base_url, accounts):
    """普通用户 Token（session 级别）"""
    for acct in accounts:
        if acct.get("role") == "visitor":
            return _do_login(base_url, acct["username"], acct["password"])
    # 如果没有 visitor 账号，返回 None
    return None


