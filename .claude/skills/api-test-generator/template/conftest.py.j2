"""
conftest.py — pytest 共享 fixture 配置
从 config.yaml 读取后端地址和测试账号，运行时从 YAML 加载用例数据
"""
import pytest
import requests
import yaml
import os
import time
from pathlib import Path

# 项目根目录（相对于此文件的位置向上查找）
PROJECT_ROOT = Path(__file__).resolve().parent.parent.parent.parent


def load_yaml(path: str) -> dict:
    """加载 YAML 文件"""
    full_path = PROJECT_ROOT / path
    if not full_path.exists():
        pytest.fail(f"配置文件不存在: {full_path}")
    with open(full_path, "r", encoding="utf-8") as f:
        return yaml.safe_load(f)


def load_config() -> dict:
    """加载项目 config.yaml"""
    return load_yaml("config.yaml")


def get_env_url(config: dict) -> str:
    """从 config.yaml 提取当前环境的 base_url"""
    env = config.get("current_environment", "dev")
    backends = config.get("environments", {}).get(env, {}).get("backend", [])
    if not backends:
        raise ValueError(f"config.yaml 中 environments.{env}.backend 未配置")
    url = backends[0].get("url", "")
    if not url:
        raise ValueError(f"config.yaml 中 environments.{env}.backend[0].url 为空")
    return url.rstrip("/")


def get_test_accounts(config: dict) -> list[dict]:
    """从 config.yaml 提取测试账号列表"""
    env = config.get("current_environment", "dev")
    return config.get("environments", {}).get(env, {}).get("frontend", [])[0].get("accounts", [])


def resolve_variables(data, context: dict) -> object:
    """递归替换数据中的 ${variable} 占位符

    支持的变量:
        ${timestamp}    — 当前时间戳
        ${admin_token}  — 管理员 Token
        ${visitor_token} — 普通用户 Token
        ${test_user_id} — 测试创建的用户 ID
        等 context 中任意 key
    """
    import re

    if isinstance(data, str):
        def replace_var(match):
            var_name = match.group(1)
            if var_name == "timestamp":
                return str(int(time.time()))
            return str(context.get(var_name, match.group(0)))
        return re.sub(r'\$\{(\w+)\}', replace_var, data)

    if isinstance(data, dict):
        return {k: resolve_variables(v, context) for k, v in data.items()}

    if isinstance(data, list):
        return [resolve_variables(item, context) for item in data]

    return data


