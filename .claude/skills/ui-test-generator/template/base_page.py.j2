"""
基础页面类 - Page Object模式基类
"""
from playwright.sync_api import Page
from typing import Optional


class BasePage:
    """所有页面类的基类"""

    def __init__(self, page: Page):
        self.page = page

    def navigate(self, path: str):
        """导航到指定路径"""
        self.page.goto(path)

    def get_url(self) -> str:
        """获取当前URL"""
        return self.page.url

    def wait_for_url(self, url_pattern: str, timeout: int = 5000):
        """等待URL匹配指定模式"""
        self.page.wait_for_url(url_pattern, timeout=timeout)

    def wait_for_selector(self, selector: str, timeout: int = 5000):
        """等待元素可见"""
        self.page.wait_for_selector(selector, state="visible", timeout=timeout)

    def click(self, selector: str, timeout: int = 5000):
        """点击元素"""
        self.wait_for_selector(selector, timeout=timeout)
        self.page.click(selector)

    def fill(self, selector: str, value: str, timeout: int = 5000):
        """填写表单"""
        self.wait_for_selector(selector, timeout=timeout)
        self.page.fill(selector, value)

    def get_text(self, selector: str) -> Optional[str]:
        """获取元素文本"""
        element = self.page.query_selector(selector)
        return element.inner_text() if element else None

    def is_visible(self, selector: str) -> bool:
        """检查元素是否可见"""
        element = self.page.query_selector(selector)
        return element.is_visible() if element else False

    def is_disabled(self, selector: str) -> bool:
        """检查元素是否禁用"""
        element = self.page.query_selector(selector)
        return element.is_disabled() if element else False

    def screenshot(self, path: str):
        """截图"""
        self.page.screenshot(path=path)

    def reload(self):
        """刷新页面"""
        self.page.reload()