import pytest
from playwright.sync_api import Page
from pages.login_page import LoginPage
import conftest


class Test{{ module_class_name }}:
    """{{ module_description }}测试类"""

    # ===========================
    # 成功场景
    # ===========================

    {% for scenario in scenarios %}
    {% if scenario.type == 'success' %}
    def test_{{ scenario.name | replace(' ', '_') | lower }}(
        self, logged_in_page: Page, base_url: str
    ):
        """{{ scenario.description }}"""
        page = logged_in_page

        # 导航到目标页面 - Vue SPA使用hash模式路由
        full_url = conftest.make_spa_url(base_url, "{{ scenario.path }}")

        try:
            page.goto(full_url, timeout=10000)
        except Exception as e:
            page.screenshot(path="{{ module_name }}_{{ scenario.name }}_error.png")
            pytest.fail(f"Cannot navigate to {{ scenario.path }}: {e}")

        # 等待页面加载
        page.wait_for_load_state("domcontentloaded", timeout=10000)
        page.wait_for_timeout(1000)  # 等待Vue路由完成

        # 验证关键元素
        {% if scenario.wait_for_selector %}
        try:
            page.wait_for_selector("{{ scenario.wait_for_selector }}", timeout=5000)
        except Exception:
            pytest.fail("Required element '{{ scenario.wait_for_selector }}' not found")
        {% endif %}

        # 验证关键内容
        {% for assertion in scenario.assertions %}
        {% if assertion.type == 'element_visible' %}
        if page.is_visible("{{ assertion.selector }}"):
            assert True
        {% elif assertion.type == 'url_contains' %}
        if "{{ assertion.value }}" in page.url:
            assert True
        {% elif assertion.type == 'text_visible' %}
        if page.is_visible("text={{ assertion.value }}"):
            assert True
        {% endif %}
        {% endfor %}

    {% endif %}
    {% endfor %}

