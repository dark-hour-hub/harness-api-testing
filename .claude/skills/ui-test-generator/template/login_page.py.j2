"""
登录页面 - Page Object
支持多选择器回退机制
"""
from playwright.sync_api import Page
from typing import Optional, List


class LoginPage:
    """登录页面"""

    def __init__(self, page: Page):
        self.page = page

    # ===== 页面元素定位器（多选择器回退） =====

    USERNAME_INPUTS = [
        "#username",
        "input[name='username']",
        "input[placeholder*='用户名']",
        "input[placeholder*='用户']",
        "input[placeholder*='username']",
        "input[placeholder*='user']",
        ".el-input__inner",
        "input[type='text']"
    ]

    PASSWORD_INPUTS = [
        "#password",
        "input[name='password']",
        "input[placeholder*='密码']",
        "input[placeholder*='password']",
        "input[type='password']"
    ]

    LOGIN_BUTTONS = [
        "button[type='submit']",
        "button:has-text('登录')",
        "button:has-text('登入')",
        "button:has-text('Login')",
        "button:has-text('login')",
        ".el-button--primary",
        "[class*='login'] button",
        "button"
    ]

    ERROR_MESSAGE_SELECTORS = [
        ".el-message--error",
        ".el-message__content",
        ".alert-danger",
        "[class*='error']",
        "[class*='Error']",
        ".tips",
        "[class*='tip']"
    ]

    # ===== 辅助方法 =====

    def find_element(self, selectors: List[str]) -> Optional[str]:
        """查找第一个匹配的选择器"""
        for selector in selectors:
            if self.page.query_selector(selector):
                return selector
        return None

    def find_all_elements(self, selectors: List[str]) -> List[str]:
        """查找所有匹配的选择器"""
        return [s for s in selectors if self.page.query_selector(s)]

    # ===== 页面操作方法 =====

    def navigate(self, base_url: str):
        """导航到登录页 - 尝试多种URL格式"""
        login_urls = [
            f"{base_url}/#/login",
            f"{base_url}/#/login/",
            f"{base_url}/login",
            f"{base_url}/login/",
            f"{base_url}/#/",
            f"{base_url}/",
            base_url.rstrip("/"),
        ]

        for url in login_urls:
            try:
                self.page.goto(url, timeout=5000)
                self.page.wait_for_load_state("domcontentloaded", timeout=5000)
                self.page.wait_for_timeout(500)

                if self.find_element(self.USERNAME_INPUTS):
                    return
            except Exception:
                continue

    def login(self, username: str, password: str, remember: bool = False) -> bool:
        """
        执行登录

        Args:
            username: 用户名
            password: 密码
            remember: 是否记住密码

        Returns:
            是否登录成功（通过URL变化判断）
        """
        # 查找元素
        username_input = self.find_element(self.USERNAME_INPUTS)
        password_input = self.find_element(self.PASSWORD_INPUTS)
        login_button = self.find_element(self.LOGIN_BUTTONS)

        if not username_input:
            return False
        if not password_input:
            return False
        if not login_button:
            return False

        # 填写表单
        self.page.fill(username_input, username)
        self.page.fill(password_input, password)

        # 可选：记住密码
        if remember:
            remember_checkbox = self.find_element(["input[type='checkbox']"])
            if remember_checkbox:
                self.page.check(remember_checkbox)

        # 点击登录
        self.page.click(login_button)
        self.page.wait_for_timeout(2000)

        # 检查URL是否离开登录页
        current_url = self.page.url
        if "/login" not in current_url and "#/login" not in current_url:
            return True

        # 检查是否有错误提示
        if self.get_error_message():
            return False

        return True

    def login(self, username: str, password: str, remember: bool = False) -> bool:
        """
        执行登录

        Args:
            username: 用户名
            password: 密码
            remember: 是否记住密码

        Returns:
            是否登录成功（通过URL变化判断）
        """
        # 查找元素
        username_input = self.find_element(self.USERNAME_INPUTS)
        password_input = self.find_element(self.PASSWORD_INPUTS)
        login_button = self.find_element(self.LOGIN_BUTTONS)

        if not username_input:
            return False
        if not password_input:
            return False
        if not login_button:
            return False

        # 填写表单
        self.page.fill(username_input, username)
        self.page.fill(password_input, password)

        # 可选：记住密码
        if remember:
            remember_checkbox = self.find_element(["input[type='checkbox']"])
            if remember_checkbox:
                self.page.check(remember_checkbox)

        # 点击登录
        self.page.click(login_button)

        # 等待登录完成（URL变化）
        try:
            self.page.wait_for_url("**/[^login]**", timeout=5000)
            return True
        except Exception:
            return False

    def get_error_message(self) -> Optional[str]:
        """获取错误提示信息"""
        error_selector = self.find_element(self.ERROR_MESSAGE_SELECTORS)
        if error_selector:
            error_element = self.page.query_selector(error_selector)
            return error_element.inner_text() if error_element else None
        return None

    def is_login_button_disabled(self) -> bool:
        """检查登录按钮是否禁用"""
        login_button = self.find_element(self.LOGIN_BUTTONS)
        if login_button:
            button = self.page.query_selector(login_button)
            return button.is_disabled() if button else True
        return True

    def is_at_login_page(self) -> bool:
        """判断是否在登录页"""
        return "/login" in self.page.url

    def clear_form(self):
        """清空表单"""
        username_input = self.find_element(self.USERNAME_INPUTS)
        password_input = self.find_element(self.PASSWORD_INPUTS)

        if username_input:
            self.page.fill(username_input, "")
        if password_input:
            self.page.fill(password_input, "")

    def submit_empty_form(self):
        """提交空表单"""
        login_button = self.find_element(self.LOGIN_BUTTONS)
        if login_button:
            self.page.click(login_button)

    def wait_for_page_load(self, timeout: int = 10000):
        """等待页面加载完成"""
        self.page.wait_for_load_state("domcontentloaded", timeout=timeout)

    def screenshot(self, path: str):
        """截图用于调试"""
        self.page.screenshot(path=path)