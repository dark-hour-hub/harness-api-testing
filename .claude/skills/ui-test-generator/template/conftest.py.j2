def _try_navigate_and_find_login(page: Page, base_url: str) -> bool:
    """尝试多种方式导航到登录页"""
    login_urls = [
        f"{base_url}/#/login",
        f"{base_url}/#/login/",
        f"{base_url}/login",
        f"{base_url}/login/",
        f"{base_url}/#/",
        f"{base_url}/",
        base_url.rstrip("/"),
    ]

    for url in login_urls:
        try:
            page.goto(url, timeout=5000)
            page.wait_for_load_state("domcontentloaded", timeout=5000)
            page.wait_for_timeout(500)

            username_selectors = [
                "#username", "input[name='username']",
                "input[placeholder*='用户名']", "input[placeholder*='用户']",
                "input[placeholder*='username']", "input[placeholder*='user']",
                ".el-input__inner", "input[type='text']"
            ]

            for selector in username_selectors:
                if page.query_selector(selector):
                    return True

        except Exception:
            continue

    return False


def _do_login(page: Page, base_url: str, username: str, password: str) -> bool:
    """
    执行登录的辅助函数

    Returns:
        True if login succeeded, False otherwise
    """
    if not _try_navigate_and_find_login(page, base_url):
        return False

    # 查找用户名输入框 - 多选择器回退
    username_selectors = [
        "#username", "input[name='username']",
        "input[placeholder*='用户名']", "input[placeholder*='用户']",
        "input[placeholder*='username']", "input[placeholder*='user']",
        ".el-input__inner", "input[type='text']"
    ]
    password_selectors = [
        "#password", "input[name='password']",
        "input[placeholder*='密码']", "input[placeholder*='password']",
        "input[type='password']"
    ]
    login_button_selectors = [
        "button[type='submit']",
        "button:has-text('登录')", "button:has-text('登入')",
        "button:has-text('Login')", "button:has-text('login')",
        ".el-button--primary",
        "[class*='login'] button",
        "button"
    ]

    username_input = None
    password_input = None
    login_button = None

    for selector in username_selectors:
        if page.query_selector(selector):
            username_input = selector
            break

    for selector in password_selectors:
        if page.query_selector(selector):
            password_input = selector
            break

    for selector in login_button_selectors:
        if page.query_selector(selector):
            login_button = selector
            break

    if not username_input or not password_input or not login_button:
        return False

    # 填写登录表单
    page.fill(username_input, username)
    page.fill(password_input, password)
    page.click(login_button)

    # 等待登录完成 - 检查URL是否离开登录页
    page.wait_for_timeout(2000)

    current_url = page.url
    if "/login" not in current_url and "#/login" not in current_url:
        return True

    # 检查是否有错误提示
    error_selectors = [".el-message--error", ".alert-danger", "[class*='error']"]
    for selector in error_selectors:
        if page.is_visible(selector):
            return False

    return True


@pytest.fixture
def logged_in_page(page, base_url):
    """已登录的页面实例 - 管理员用户"""
    success = _do_login(page, base_url,
                          TEST_ACCOUNTS["admin"]["username"],
                          TEST_ACCOUNTS["admin"]["password"])

    if not success:
        page.screenshot(path="login_result.png")
