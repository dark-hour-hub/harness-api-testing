# ===========================
# 辅助函数
# ===========================

def find_first_selector(page: Page, selectors: list) -> str:
    """查找第一个匹配的选择器"""
    for selector in selectors:
        if page.query_selector(selector):
            return selector
    return None


def make_spa_url(base_url: str, path: str) -> str:
    """将路径转换为Vue SPA hash模式URL

    Args:
        base_url: 前端服务地址，如 http://localhost:5173
        path: 路由路径，如 /admin/list 或 admin/list

    Returns:
        Vue SPA格式的完整URL，如 http://localhost:5173/#/admin/list
    """
    if not path:
        return base_url
    if path.startswith("/#/"):
        return f"{base_url}{path}"
    if path.startswith("/"):
        return f"{base_url}/#{path}"
    return f"{base_url}/#{path}"


def assert_element_visible(page: Page, selector: str, timeout: int = 5000):
    """断言元素可见并等待"""
    page.wait_for_selector(selector, state="visible", timeout=timeout)


def assert_text_visible(page: Page, text: str, timeout: int = 5000):
    """断言文本可见"""
    page.wait_for_selector(f"text={text}", state="visible", timeout=timeout)


def assert_url_contains(page: Page, path: str):
    """断言URL包含指定路径"""
    assert path in page.url


def assert_login_success(page: Page, base_url: str):
    """断言登录成功"""
    assert "/login" not in page.url or page.is_visible("text=登录成功")


def assert_login_failed(page: Page):
    """断言登录失败"""
    assert "/login" in page.url


# 暴露辅助函数到pytest
pytest.find_first_selector = find_first_selector
pytest.make_spa_url = make_spa_url
pytest.assert_element_visible = assert_element_visible
pytest.assert_text_visible = assert_text_visible
pytest.assert_url_contains = assert_url_contains
pytest.assert_login_success = assert_login_success
pytest.assert_login_failed = assert_login_failed